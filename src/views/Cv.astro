---
import Link from '../components/Link.astro'
import { SITE_TITLE } from '../consts'
import Layout from '../layouts/Layout.astro'
import { cv } from '../data/cv'
import { getLang, localizePath } from '../i18n'
import { ui } from '../i18n/ui'

const lang = getLang(Astro.currentLocale)
const { headline, experience, education, skills, labels } = cv[lang]
const copy = {
  en: {
    heading: 'CV',
    title: `CV — ${SITE_TITLE}, AI Developer in Porto Alegre`,
    description: `CV of ${SITE_TITLE} (Marcus Filipe), AI developer and software engineer in Porto Alegre, Brazil. ${headline}`,
  },
  'pt-br': {
    heading: 'Currículo',
    title: `Currículo — ${SITE_TITLE}, Desenvolvedor de IA em Porto Alegre`,
    description: `Currículo de ${SITE_TITLE} (Marcus Filipe), desenvolvedor de IA e engenheiro de software em Porto Alegre. ${headline}`,
  },
}[lang]
---

<Layout
  title={copy.title}
  description={copy.description}
  jsonLd={[
    {
      '@type': 'ProfilePage',
      url: new URL(localizePath('/cv/', lang), Astro.site).href,
      name: `${copy.heading} — ${SITE_TITLE}`,
      mainEntity: { '@id': new URL('/#person', Astro.site).href },
      isPartOf: { '@id': new URL('/#website', Astro.site).href },
    },
  ]}
>
  <h1
    class='mb-3 mt-6 bg-gradient-to-r from-rose-400 via-red-500 to-yellow-500 bg-300 bg-clip-text text-4xl font-bold tracking-tight text-transparent animate-gradient md:text-5xl'
  >
    {copy.heading}
  </h1>
  <p class='mb-2 text-lg font-bold text-slate-100'>Marcus Filipe Quirino · {ui[lang].location}</p>
  <p class='mb-6 max-w-[38rem] text-lg font-light'>{headline}</p>
  <a
    href={localizePath('/cv.pdf', lang)}
    download={labels.fileName}
    class='mb-10 inline-flex min-h-[44px] items-center gap-2 rounded-xl bg-rose-400 px-5 font-bold text-zinc-900 no-underline hover:bg-rose-300'
  >
    {labels.download}
  </a>

  <section>
    <h2 class='mb-4 text-2xl font-bold text-slate-100'>{labels.experience}</h2>
    <ol class='m-0 list-none space-y-6 border-l border-zinc-700 p-0 pl-5'>
      {
        experience.map(job => (
          <li class='relative'>
            <span class='absolute -left-[1.55rem] top-2 h-2.5 w-2.5 rounded-full bg-rose-400' />
            <div class='flex flex-wrap items-baseline justify-between gap-x-4'>
              <h3 class='m-0 text-lg font-bold text-slate-100'>
                {job.title} · {job.url ? <Link href={job.url}>{job.company}</Link> : job.company}
              </h3>
              <span class='text-sm text-zinc-400'>
                {job.start} – {job.end ?? labels.present}
              </span>
            </div>
            <p class='mb-1 mt-1'>{job.summary}</p>
            {job.highlights && (
              <ul class='m-0 list-disc pl-5 text-zinc-400'>
                {job.highlights.map(h => (
                  <li>{h}</li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ol>
  </section>

  <section class='mt-12'>
    <h2 class='mb-4 text-2xl font-bold text-slate-100'>{labels.education}</h2>
    {
      education.map(e => (
        <p class='m-0'>
          <span class='font-bold text-slate-100'>{e.course}</span>, <Link href={e.url}>{e.school}</Link>. {e.note}
        </p>
      ))
    }
  </section>

  <section class='mt-12'>
    <h2 class='mb-4 text-2xl font-bold text-slate-100'>{labels.skills}</h2>
    <ul class='m-0 flex list-none flex-wrap gap-2 p-0'>
      {
        skills.map(s => (
          <li class='rounded-lg border border-zinc-600 px-2.5 py-0.5 text-sm text-slate-100'>{s}</li>
        ))
      }
    </ul>
  </section>

  <p class='mt-12 text-zinc-400'>
    {labels.fullHistory} <Link href='https://www.linkedin.com/in/marcus-quirino-dev/'>LinkedIn</Link>.
  </p>
</Layout>
