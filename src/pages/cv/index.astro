---
import Link from '../../components/Link.astro'
import { SITE_TITLE } from '../../consts'
import Layout from '../../layouts/Layout.astro'
import { headline, experience, education, skills } from '../../data/cv'
---

<Layout
  title={`${SITE_TITLE} - CV`}
  description={headline}
>
  <h1
    class='mb-3 mt-6 bg-gradient-to-r from-rose-400 via-red-500 to-yellow-500 bg-300% bg-clip-text text-4xl font-bold tracking-tight text-transparent animate-gradient md:text-5xl'
  >
    CV
  </h1>
  <p class='mb-10 max-w-[38rem] text-lg font-light'>{headline}</p>

  <section>
    <h2 class='mb-4 text-2xl font-bold text-slate-100'>Experience</h2>
    <ol class='m-0 list-none space-y-6 border-l border-zinc-700 p-0 pl-5'>
      {
        experience.map(job => (
          <li class='relative'>
            <span class='absolute -left-[1.55rem] top-2 h-2.5 w-2.5 rounded-full bg-rose-400' />
            <div class='flex flex-wrap items-baseline justify-between gap-x-4'>
              <h3 class='m-0 text-lg font-bold text-slate-100'>
                {job.title} · {job.url ? <Link href={job.url}>{job.company}</Link> : job.company}
              </h3>
              <span class='text-sm text-zinc-400'>
                {job.start} – {job.end ?? 'present'}
              </span>
            </div>
            <p class='mb-1 mt-1'>{job.summary}</p>
            {job.highlights && (
              <ul class='m-0 list-disc pl-5 text-zinc-400'>
                {job.highlights.map(h => (
                  <li>{h}</li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ol>
  </section>

  <section class='mt-12'>
    <h2 class='mb-4 text-2xl font-bold text-slate-100'>Education</h2>
    {
      education.map(e => (
        <p class='m-0'>
          <span class='font-bold text-slate-100'>{e.course}</span>, <Link href={e.url}>{e.school}</Link>. {e.note}
        </p>
      ))
    }
  </section>

  <section class='mt-12'>
    <h2 class='mb-4 text-2xl font-bold text-slate-100'>Skills</h2>
    <ul class='m-0 flex list-none flex-wrap gap-2 p-0'>
      {
        skills.map(s => (
          <li class='rounded-lg border border-zinc-600 px-2.5 py-0.5 text-sm text-slate-100'>{s}</li>
        ))
      }
    </ul>
  </section>

  <p class='mt-12 text-zinc-400'>
    Full history on <Link href='https://www.linkedin.com/in/marcus-quirino-dev/'>LinkedIn</Link>.
  </p>
</Layout>
