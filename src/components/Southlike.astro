---
import { SOUTHLIKE_URL } from '../consts'
import { getLang } from '../i18n'
import { ui } from '../i18n/ui'

const t = ui[getLang(Astro.currentLocale)].southlike
---

<div class='grid gap-4 rounded-2xl border border-rose-400 bg-zinc-800 p-6'>
  <div class='flex items-center gap-3 text-xl font-extrabold text-slate-100'>
    <span class='h-3.5 w-3.5 rounded-full bg-gradient-to-br from-rose-400 to-yellow-500'></span>
    Southlike Software
  </div>
  <p class='m-0'>{t.pitch}</p>
  <ul class='m-0 grid list-none gap-2 p-0'>
    {
      t.services.map(item => (
        <li class='flex items-baseline gap-2.5'>
          <span class='h-2 w-2 flex-none translate-y-[-2px] rounded-full bg-rose-400' />
          {item}
        </li>
      ))
    }
  </ul>
  <div class='flex flex-wrap gap-3'>
    <a
      href={SOUTHLIKE_URL}
      target='_blank'
      rel='noopener noreferrer'
      class='inline-flex min-h-[44px] items-center justify-center rounded-xl bg-rose-400 px-5 font-bold text-zinc-900 no-underline hover:bg-rose-300'
    >
      {t.visit}
    </a>
    <a
      href={`${SOUTHLIKE_URL}/servicos`}
      target='_blank'
      rel='noopener noreferrer'
      class='inline-flex min-h-[44px] items-center justify-center rounded-xl border border-zinc-600 px-5 font-semibold text-slate-100 no-underline hover:border-rose-400'
    >
      {t.whatWeDo}
    </a>
  </div>
</div>
