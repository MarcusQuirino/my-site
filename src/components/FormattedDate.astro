---
import { LOCALE_TAGS, getLang } from '../i18n';

interface Props {
	date: Date;
}

const { date } = Astro.props;
const locale = LOCALE_TAGS[getLang(Astro.currentLocale)];
---

<time datetime={date.toISOString()}>
	{
		date.toLocaleDateString(locale, {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
		})
	}
</time>
