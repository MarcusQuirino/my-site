---
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'a'>

const { href, class: className, ...props } = Astro.props

const { pathname } = Astro.url
const path = pathname.replace(/\/$/, '') || '/'
const isActive = href === path || (href !== '/' && typeof href === 'string' && path.startsWith(href))
---

<a
  href={href}
  class:list={[
    'inline-block border-b-2 pb-0.5 no-underline hover:text-rose-300',
    isActive ? 'border-rose-400 text-slate-100' : 'border-transparent',
    className,
  ]}
  aria-current={isActive ? 'page' : undefined}
  {...props}
>
  <slot />
</a>
