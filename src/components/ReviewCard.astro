---
import type { CollectionEntry } from 'astro:content'
import type { HTMLAttributes } from 'astro/types'
import { Image } from 'astro:assets'
import { getLang, localizePath } from '../i18n'
import { entrySlug } from '../i18n/content'

type Props = CollectionEntry<'reviews'> & HTMLAttributes<'a'>

const { data, id } = Astro.props
const { name, image } = data
const slug = entrySlug(id)
---

<a
  href={localizePath(`/setup/${slug}/`, getLang(Astro.currentLocale))}
  class='flex flex-col overflow-hidden border border-rose-400 rounded-2xl bg-zinc-800 text-gray-400 max-h-40 hover:bg-zinc-900'
>
  <div class='basis-1/3 p-2'>
    <h3 class='text-slate-100 font-bold text-center h-12'>
      {name}
    </h3>
  </div>
  <Image
    transition:name={`image-${slug}`}
    src={image}
    alt={name}
    quality={1}
    format='avif'
    class='w-full basis-1/3 rounded-t-2xl'
  />
</a>
