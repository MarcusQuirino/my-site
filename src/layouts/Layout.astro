---
import BaseHead from '../components/BaseHead.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import { ClientRouter } from 'astro:transitions'
import type { ComponentProps } from 'astro/types'
import { LOCALE_TAGS, getLang } from '../i18n'

type Props = ComponentProps<typeof BaseHead>

const props = Astro.props
const lang = getLang(Astro.currentLocale)
---

<!doctype html>
<html lang={LOCALE_TAGS[lang]}>
  <head>
    <BaseHead {...props} />
    <ClientRouter />
  </head>
  <body
    class='min-h-screen text-zinc-300 antialiased flex justify-center'
  >
    <div class='w-full max-w-3xl p-4'>
      <Header />
      <main class='px-1'>
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
